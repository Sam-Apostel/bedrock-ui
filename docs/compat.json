  "groups": {
    "dialog": {
      "title": "Dialog and AlertDialog",
      "blurb": "The floor lives here. Without these two, a trigger is an inert button \u2014 everything below is degradation, this is absence."
    },
    "overlay": {
      "title": "Popover, Tooltip, HoverCard, Select and menus",
      "blurb": "Everything that opens next to the thing that opened it. Missing anchor positioning costs placement, not behaviour."
    },
    "motion": {
      "title": "Transitions and animation",
      "blurb": "Entry and exit only. Every row here fails to a jump cut; none of them fails to a broken component."
    },
    "state": {
      "title": "State selectors and disclosure",
      "blurb": "How your CSS asks whether something is open, and how an accordion keeps one panel at a time."
    },
    "foundations": {
      "title": "The parts that were already there",
      "blurb": "None of these are news, which is the point: they carry half the library and they carried it a decade ago. They are in the table because the timeline needs them \u2014 a component whose only requirement shipped in 2011 was never waiting for anything."
    }
  },
