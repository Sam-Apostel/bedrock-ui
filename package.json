{
  "name": "@apostel/bedrock",
  "version": "0.2.0",
  "description": "Headless React primitives built on native platform features",
  "keywords": [
    "accessibility",
    "anchor-positioning",
    "dialog",
    "headless",
    "invoker-commands",
    "popover",
    "primitives",
    "radix",
    "react"
  ],
  "homepage": "https://github.com/Sam-Apostel/bedrock-ui#readme",
  "bugs": "https://github.com/Sam-Apostel/bedrock-ui/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sam-Apostel/bedrock-ui.git"
  },
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./controlled": {
      "types": "./dist/controlled.d.ts",
      "default": "./dist/controlled.js"
    },
    "./bedrock.css": "./dist/bedrock.css"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "changeset": "changeset",
    "compat:build": "node scripts/build-compat.mjs",
    "demos:build": "vite build --config vite.demos.config.ts",
    "docs:baseline": "node scripts/build-baseline.mjs",
    "docs:build": "node scripts/build-docs.mjs && npm run demos:build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:graph": "depcruise src --config .dependency-cruiser.cjs",
    "prepublishOnly": "npm run verify",
    "registry:build": "node scripts/build-registry.mjs",
    "release": "changeset publish",
    "test": "playwright test",
    "test:install": "playwright install chromium",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run lint:graph && npm run build && npm run test",
    "version": "changeset version"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@changesets/cli": "^3.0.1",
    "@mdn/browser-compat-data": "^8.0.13",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.0.5",
    "clsx": "^2.1.1",
    "dependency-cruiser": "^16.0.0",
    "lucide-react": "^1.39.0",
    "marked": "^15.0.12",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0",
    "vite": "^8.2.0",
    "web-features": "^3.36.0"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "engines": {
    "node": ">=20"
  }
}
